# --- Database (Supabase Postgres) ---
# Get this from Supabase Dashboard: Project Settings -> Database -> Connection string -> "Session pooler".
# Change the prefix to postgresql+psycopg2:// and fill in your project ref, password and region.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth / JWT ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
